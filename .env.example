# INDRA INFINITY SECURITY - CONFIGURACION
# Copia este archivo a ".env" y ajusta los valores. ".env" nunca se sube al repositorio.

# Llave de licencia (alternativa: guardarla en config/license.key)
INDRA_LICENSE_KEY=

GOJO_ENV=production
GOJO_HOST=127.0.0.1
GOJO_PORT=8000

# Token de la API. OBLIGATORIO si GOJO_HOST no es 127.0.0.1 (p. ej. 0.0.0.0 para acceso en LAN).
# El panel web lo solicitara la primera vez y lo guardara en el navegador.
GOJO_API_TOKEN=

# Hosts aceptados en la cabecera Host (proteccion contra DNS rebinding), separados por comas.
# Vacio = 127.0.0.1, localhost, ::1 (o cualquiera si GOJO_HOST=0.0.0.0).
GOJO_ALLOWED_HOSTS=

# Origenes externos autorizados a llamar a la API (CORS). Vacio = solo el propio panel.
GOJO_CORS_ORIGINS=

# Peticiones por minuto por IP antes del rate limiting de Infinity Shield.
GOJO_RATE_LIMIT=240

# Dias de retencion del historial de visitas por IP.
GOJO_IP_RETENTION_DAYS=30

# Directorio de datos en tiempo de ejecucion (BD, logs, reportes, backups, cuarentena).
# GOJO_DATA_DIR=
